import { LineEdit, ListView, Palette } from "std-widgets.slint";

export struct UiConversation {
    id: int,
    title: string,
    avatar-text: string,
    avatar-color: color,
    avatar-image: image,
    unread: bool,
    other-user-id: int,
}

export struct UiMessage {
    id: int,
    sender: string,
    body: string,
    created-at: string,
    is-self: bool,
    sender-id: int,
    avatar-text: string,
    avatar-color: color,
    avatar-image: image,
    attachment-image: image,
    attachment-name: string,
    attachment-mime: string,
    preview-title: string,
    preview-description: string,
    preview-image: image,
    preview-url: string,
}

export struct UiContact {
    id: int,
    name: string,
    handle: string,
    avatar-text: string,
    avatar-color: color,
    avatar-image: image,
}

export struct UiProfile {
    id: int,
    username: string,
    display-name: string,
    handle: string,
    avatar-text: string,
    avatar-color: color,
    avatar-image: image,
    is-self: bool,
    blocked: bool,
    muted: bool,
    blocked-by: bool,
}

component Avatar inherits Rectangle {
    in property <string> avatar-text: "";
    in property <color> avatar-color: #888888;
    in property <image> avatar-image;
    in property <length> size: 36px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.avatar-color;
    clip: true;
    if root.avatar-image.width > 0: Image {
        width: 100%;
        height: 100%;
        source: root.avatar-image;
        image-fit: cover;
    }
    if !(root.avatar-image.width > 0): HorizontalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        Text {
            text: root.avatar-text;
            color: white;
            font-size: root.size / 2.6;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component CloseButton inherits Rectangle {
    in property <brush> text-color: #000000;
    callback clicked;
    width: 26px;
    height: 26px;
    border-radius: 13px;
    HorizontalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        Text {
            text: "×";
            color: root.text-color;
            font-size: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

component ContextMenuItem inherits Rectangle {
    in property <string> text: "";
    in property <brush> text-color: #000000;
    in property <brush> item-background: transparent;
    in property <brush> item-hover-background: transparent;
    callback clicked;
    height: 34px;
    border-radius: 6px;
    background: root.item-background;
    states [
        hover when ta.has-hover: { background: root.item-hover-background; }
    ]
    ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        HorizontalLayout {
            padding-left: 10px;
            Text {
                text: root.text;
                color: root.text-color;
                font-size: 14px;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }
    }
}

component Button inherits Rectangle {
    in property <string> text: "";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <brush> accent: #7C5CE0;
    in property <brush> on-accent: #FFFFFF;
    callback clicked;

    property <brush> bg: root.primary ? root.accent : Palette.control-background;
    property <brush> label-color: root.primary ? root.on-accent : Palette.control-foreground;

    min-width: 64px;
    height: 36px;
    border-radius: 8px;
    background: root.bg;
    border-width: 1px;
    border-color: Palette.border;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.text;
            color: root.label-color;
            font-size: 14px;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    states [
        disabled when !root.enabled : {
            bg: Palette.control-background.with-alpha(0.4);
            label-color: Palette.control-foreground.with-alpha(0.4);
        }
        pressed-primary when root.enabled && ta.pressed && root.primary : {
            bg: root.accent.with-alpha(0.72);
        }
        pressed when root.enabled && ta.pressed : {
            bg: Palette.control-background.with-alpha(0.35);
        }
        hover-primary when root.enabled && ta.has-hover && root.primary : {
            bg: root.accent.with-alpha(0.85);
        }
        hover when root.enabled && ta.has-hover : {
            bg: Palette.control-background.with-alpha(0.55);
        }
    ]
    animate bg { duration: 60ms; }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component NewChatForm inherits Rectangle {
    in-out property <string> chat-input: "";
    in property <[UiContact]> suggestions;
    in property <string> error-message: "";
    in property <color> accent-color: #7C5CE0;
    in-out property <bool> focus-end-tick: false;
    in-out property <int> cursor-len: 0;
    callback create-chat(input: string);
    callback pick-contact(id: int);
    callback append-done();

    changed focus-end-tick => {
        if self.focus-end-tick {
            nc-input.set-selection-offsets(self.cursor-len, self.cursor-len);
            self.append-done();
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 12px;
        Text {
            text: "Start a conversation";
            font-size: 18px;
            font-weight: 600;
            color: Palette.foreground;
            horizontal-alignment: center;
        }
        Text {
            text: "Enter one or more usernames, separated by commas";
            color: Palette.foreground.with-alpha(0.72);
            horizontal-alignment: center;
        }
        HorizontalLayout { alignment: center;
            Rectangle {
                width: 460px;
                height: 56px;
                border-width: 1px;
                border-radius: 8px;
                border-color: nc-input.has-focus ? root.accent-color : Palette.border;
                background: Palette.background;
                nc-input := LineEdit {
                    x: 10px;
                    y: 10px;
                    width: parent.width - 20px;
                    height: parent.height - 20px;
                    text <=> root.chat-input;
                    placeholder-text: "@alice@example.com, @bob@example.com";
                    accepted(text) => {
                        root.create-chat(root.chat-input);
                    }
                }
            }
        }
        if root.suggestions.length > 0: HorizontalLayout { alignment: center;
            Rectangle {
                width: 460px;
                height: 170px;
                border-radius: 12px;
                background: Palette.alternate-background;
                ListView {
                    for c in root.suggestions: Rectangle {
                        height: 46px;
                        background: Palette.alternate-background;
                        TouchArea {
                            clicked => {
                                root.pick-contact(c.id);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            VerticalLayout { vertical-stretch: 1; alignment: center;
                                Avatar { avatar-text: c.avatar-text; avatar-color: c.avatar-color; avatar-image: c.avatar-image; size: 28px; }
                            }
                            VerticalLayout { vertical-stretch: 1; alignment: center;
                                Text { text: c.name; color: Palette.foreground; overflow: elide; }
                            }
                            Rectangle { height: 100%; }
                            VerticalLayout { vertical-stretch: 1; alignment: center;
                                Text { text: c.handle; color: Palette.foreground.with-alpha(0.72); overflow: elide; font-size: 12px; }
                            }
                        }
                    }
                }
            }
        }
        if root.error-message != "": Text {
            text: root.error-message;
            wrap: word-wrap;
            color: #B3261E;
            horizontal-alignment: center;
        }
        HorizontalLayout { alignment: center;
            Button {
                text: "Create conversation";
                primary: true;
                accent: root.accent-color;
                on-accent: #FFFFFF;
                enabled: root.chat-input != "";
                clicked => {
                    root.create-chat(root.chat-input);
                }
            }
        }
    }
}

component DarkInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <InputType> input-type: InputType.text;
    callback accepted();
    horizontal-stretch: 1;
    height: 44px;
    border-radius: 8px;
    border-width: 1px;
    border-color: ti.has-focus ? #8AB4F8 : #FFFFFF3D;
    background: #1C1C1C;
    ti := TextInput {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: 100%;
        color: #FFFFFF;
        font-size: 16px;
        single-line: true;
        vertical-alignment: center;
        input-type: root.input-type;
        text <=> root.text;
        accepted => { root.accepted(); }
    }
    Text {
        x: 14px;
        y: 0px;
        height: 100%;
        text: root.text == "" ? root.placeholder : "";
        color: #FFFFFF8A;
        font-size: 16px;
        vertical-alignment: center;
    }
}


export component MainWindow inherits Window {
    title: "FediTexter";
    width: 1000px;
    height: 700px;

    // Adaptive Material 3 palette: accent color is user-selectable; the
    // on-colors adapt to the light/dark scheme so text stays readable.
    property <brush> md3-primary: root.accent-color;
    property <brush> md3-on-primary: #FFFFFF;
    property <brush> md3-primary-container: root.accent-color.with-alpha(0.18);
    property <brush> md3-on-primary-container: root.md3-on-surface;
    property <brush> md3-secondary-container: root.accent-color.with-alpha(0.12);
    property <brush> md3-on-secondary-container: root.md3-on-surface;
    property <brush> md3-background: Palette.background;
    property <brush> md3-surface: Palette.background.with-alpha(0.86);
    property <brush> md3-on-surface: Palette.foreground;
    property <brush> md3-on-surface-variant: Palette.foreground.with-alpha(0.78);
    property <brush> md3-error: #B3261E;
    property <brush> md3-outline: Palette.border;
    property <brush> md3-surface-container: Palette.control-background.with-alpha(0.9);
    property <brush> md3-surface-container-high: Palette.control-background.with-alpha(0.9);
    property <brush> md3-surface-container-low: Palette.alternate-background.with-alpha(0.85);

    // User-selectable accent color (saved to the settings file).
    in-out property <color> accent-color: #7C5CE0;

    in property<bool> logged-in;
    in-out property<string> server-input: "http://localhost:3000";
    in property<string> user-name;
    in property<bool> ws-connected;
    in-out property<string> error-message: "";
    in-out property<int> selected-conversation: -1;
    in property<[UiConversation]> conversations;
    in property<[UiMessage]> messages;
    in property<[UiContact]> suggestions;
    in-out property<bool> settings-open: false;
    in-out property<bool> needs-verify: false;
    in-out property<bool> needs-2fa: false;
    in-out property<string> pending-token: "";
    in-out property<bool> totp-enabled: false;
    in-out property<image> twofa-qr;
    in-out property<string> twofa-secret: "";
    in-out property<bool> twofa-setup-open: false;
    in-out property<bool> twofa-disable-open: false;
    in-out property<string> twofa-code: "";
    in-out property<bool> profile-open: false;
    in-out property<UiProfile> profile: { id: -1, username: "", display-name: "", handle: "", avatar-text: "", avatar-color: #888888, is-self: false, blocked: false, muted: false, blocked-by: false };
    in-out property<bool> context-open: false;
    in-out property<int> context-user-id: -1;
    in-out property<int> context-conversation-id: -1;
    in-out property<length> context-x: 0px;
    in-out property<length> context-y: 0px;
    in-out property<bool> context-blocked: false;
    in-out property<bool> context-muted: false;
    in-out property<bool> confirm-delete-open: false;
    in-out property<int> confirm-delete-conversation-id: -1;
    in-out property<string> confirm-delete-title: "";
    in-out property<float> ui-scale: 1.0;
    property <float> ui-scale-base: 1.3;
    in-out property<bool> nc-append: false;
    in-out property<int> nc-cursor-len: 0;
    in-out property<int> msg-scroll-tick: 0;
    in-out property<bool> msg-at-bottom: false;
    in-out property<string> pending-attach-name: "";
    in-out property<image> pending-attach-image;
    in property <image> my-avatar;

    callback login(email: string, password: string);
    callback register(email: string, username: string, password: string);
    callback logout();
    callback select-conversation(id: int);
    callback send-message(body: string);
    callback new-conversation(input: string);
    callback verify(code: string);
    callback resend-code();
    callback submit-2fa(code: string);
    callback twofa-setup();
    callback twofa-enable(code: string);
    callback twofa-disable(code: string);
    callback settings-saved();
    callback settings-choose-avatar();
    callback settings-remove-avatar();
    callback choose-attachment();
    callback clear-attachment();
    callback open-link(url: string);
    callback suggestion-selected(id: int);
    callback request-profile(user-id: int);
    callback request-context(user-id: int, conversation-id: int, x: length, y: length);
    callback context-profile();
    callback toggle-block();
    callback toggle-mute();
    callback context-delete();
    callback confirm-delete();
    callback open-chat(user-id: int);

    property<string> login-email: "";
    property<string> login-password: "";
    property<string> reg-email: "";
    property<string> reg-username: "";
    property<string> reg-password: "";
    property<bool> register-mode: false;
    property<string> draft: "";
    in-out property<string> new-conversation-input: "";
    property<string> verify-code: "";
    in-out property<string> display-name-input: "";

    // ------------------------------------------------------------------
    // Scaleable content: the whole UI is scaled by root.ui-scale so the
    // Ctrl/Cmd + +/- shortcuts can zoom in and out.
    // ------------------------------------------------------------------
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width / (root.ui-scale * root.ui-scale-base);
        height: parent.height / (root.ui-scale * root.ui-scale-base);
        background: transparent;
        transform-scale-x: root.ui-scale * root.ui-scale-base * 100%;
        transform-scale-y: root.ui-scale * root.ui-scale-base * 100%;
        transform-origin: { x: 0px, y: 0px };

        // Translucent Material-You style backdrop
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(160deg, root.accent-color.with-alpha(0.45), root.accent-color.with-alpha(0.15) 40%, root.md3-background 85%, root.accent-color.with-alpha(0.35));
        }

    // ------------------------------------------------------------------
    // Login / register screen (dark grey)
    // ------------------------------------------------------------------
    if !root.logged-in: Rectangle {
        background: #232323;
        VerticalLayout {
            spacing: 10px;
            alignment: start;
            Rectangle { height: 24px; }
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    spacing: 10px;
                    width: 380px;

                    Text {
                        text: "FediTexter";
                        font-size: 34px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        color: #FFFFFF;
                    }

                    Text {
                        text: "A federated texting client";
                        horizontal-alignment: center;
                        color: #FFFFFFA6;
                    }

                    Rectangle { height: 26px; }

                    if !root.register-mode: VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Server";
                                font-size: 17px;
                                font-weight: 500;
                                color: #FFFFFF;
                                width: 100px;
                                vertical-alignment: center;
                            }
                            DarkInput {
                                text <=> root.server-input;
                                placeholder: "your-server.example";
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Email";
                                font-size: 17px;
                                font-weight: 500;
                                color: #FFFFFF;
                                width: 100px;
                                vertical-alignment: center;
                            }
                            DarkInput {
                                text <=> root.login-email;
                                placeholder: "you@example.com";
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Password";
                                font-size: 17px;
                                font-weight: 500;
                                color: #FFFFFF;
                                width: 100px;
                                vertical-alignment: center;
                            }
                            DarkInput {
                                text <=> root.login-password;
                                input-type: InputType.password;
                                accepted => {
                                    root.login(root.login-email, root.login-password);
                                }
                            }
                        }
                        Rectangle { height: 12px; }
                        Button {
                            text: "Login";
                            primary: true;
                            accent: root.accent-color;
                            on-accent: root.md3-on-primary;
                            clicked => {
                                root.login(root.login-email, root.login-password);
                            }
                        }
                        Button {
                            text: "Create account";
                            clicked => { root.register-mode = true; }
                        }
                    }

                    if root.register-mode: VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Server";
                                font-size: 17px;
                                font-weight: 500;
                                color: #FFFFFF;
                                width: 100px;
                                vertical-alignment: center;
                            }
                            DarkInput {
                                text <=> root.server-input;
                                placeholder: "your-server.example";
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Email";
                                font-size: 17px;
                                font-weight: 500;
                                color: #FFFFFF;
                                width: 100px;
                                vertical-alignment: center;
                            }
                            DarkInput {
                                text <=> root.reg-email;
                                placeholder: "you@example.com";
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Username";
                                font-size: 17px;
                                font-weight: 500;
                                color: #FFFFFF;
                                width: 100px;
                                vertical-alignment: center;
                            }
                            DarkInput {
                                text <=> root.reg-username;
                                placeholder: "alice";
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Password";
                                font-size: 17px;
                                font-weight: 500;
                                color: #FFFFFF;
                                width: 100px;
                                vertical-alignment: center;
                            }
                            DarkInput {
                                text <=> root.reg-password;
                                input-type: InputType.password;
                                accepted => {
                                    root.register(root.reg-email, root.reg-username, root.reg-password);
                                }
                            }
                        }
                        Rectangle { height: 12px; }
                        Button {
                            text: "Register";
                            primary: true;
                            accent: root.accent-color;
                            on-accent: root.md3-on-primary;
                            clicked => {
                                root.register(root.reg-email, root.reg-username, root.reg-password);
                            }
                        }
                        Button {
                            text: "Back to login";
                            clicked => { root.register-mode = false; }
                        }
                    }

                    if root.error-message != "": Text {
                        text: root.error-message;
                        wrap: word-wrap;
                        color: #FF8A80;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------------
    // Main screen
    // ------------------------------------------------------------------
    if root.logged-in: Rectangle {
        background: root.md3-surface;
        VerticalLayout {
            spacing: 0px;
            // Top app bar
            Rectangle {
                height: 56px;
                background: root.md3-surface-container;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    spacing: 12px;
                    VerticalLayout { alignment: center;
                        Text { text: "FediTexter"; font-weight: 700; color: root.md3-on-surface; }
                    }
                    Rectangle { height: 100%; }
                    VerticalLayout { alignment: center;
                        Text {
                            text: root.ws-connected ? "live" : "reconnecting…";
                            color: root.ws-connected ? #66BB6A : root.md3-on-surface-variant;
                            font-size: 12px;
                        }
                    }
                    VerticalLayout { vertical-stretch: 1; alignment: center;
                        HorizontalLayout {
                            spacing: 0px;
                            Button {
                                text: "Settings";
                                clicked => { root.settings-open = true; }
                            }
                            Button {
                                text: "Logout";
                                clicked => { root.logout(); }
                            }
                        }
                    }
                }
                VerticalLayout {
                    x: (parent.width - 360px) / 2;
                    y: 0px;
                    width: 360px;
                    height: 56px;
                    alignment: center;
                    Text {
                        text: "Logged in as @" + root.user-name;
                        horizontal-alignment: center;
                        overflow: elide;
                        color: root.md3-on-surface-variant;
                    }
                }
            }

            HorizontalLayout {
                spacing: 0px;
                // Conversation sidebar
                Rectangle {
                    width: 280px;
                    background: root.md3-surface-container-low;
                    VerticalLayout {
                        spacing: 0px;
                        Rectangle {
                            height: 52px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                VerticalLayout { vertical-stretch: 1; alignment: center;
                                    Text { text: "Conversations"; font-weight: 600; color: root.md3-on-surface; }
                                }
                                Rectangle { height: 100%; }
                                VerticalLayout { vertical-stretch: 1; alignment: center;
                                    Button {
                                        text: "New";
                                        clicked => {
                                            root.selected-conversation = -1;
                                            root.select-conversation(-1);
                                        }
                                    }
                                }
                            }
                        }
                        ListView {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            for c in root.conversations: Rectangle {
                                height: 48px;
                                background: root.selected-conversation == c.id ? root.md3-secondary-container : root.md3-surface-container-low;
                                TouchArea {
                                    clicked => {
                                        root.selected-conversation = c.id;
                                        root.select-conversation(c.id);
                                    }
                                    pointer-event(ev) => {
                                        if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                                            root.request-context(c.other-user-id, c.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 8px;
                                    spacing: 10px;
                                    VerticalLayout { vertical-stretch: 1; alignment: center;
                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            Avatar { avatar-text: c.avatar-text; avatar-color: c.avatar-color; avatar-image: c.avatar-image; size: 32px; }
                                            if c.unread: Rectangle {
                                                x: parent.width - 11px;
                                                y: -1px;
                                                width: 12px;
                                                height: 12px;
                                                border-radius: 6px;
                                                background: #E53935;
                                            }
                                            TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                clicked => {
                                                    root.selected-conversation = c.id;
                                                    root.select-conversation(c.id);
                                                    root.request-profile(c.other-user-id);
                                                }
                                                pointer-event(ev) => {
                                                    if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                                                        root.request-context(c.other-user-id, c.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    VerticalLayout { vertical-stretch: 1; alignment: center;
                                        Text {
                                            text: c.title;
                                            color: root.selected-conversation == c.id ? root.md3-on-secondary-container : root.md3-on-surface;
                                            overflow: elide;
                                        }
                                    }
                                    Rectangle { height: 100%; }
                                    if root.selected-conversation == c.id: VerticalLayout { vertical-stretch: 1; alignment: center;
                                        CloseButton {
                                            text-color: root.md3-on-secondary-container;
                                            clicked => {
                                                root.selected-conversation = -1;
                                                root.select-conversation(-1);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.error-message != "": Text {
                            text: root.error-message;
                            wrap: word-wrap;
                            color: root.md3-error;
                        }
                    }
                }

                // Chat area
                Rectangle {
                    horizontal-stretch: 1;
                    background: root.md3-surface;
                    VerticalLayout {
                        spacing: 4px;
                        padding: 10px;
                        if root.selected-conversation < 0: NewChatForm {
                            height: 100%;
                            suggestions: root.suggestions;
                            error-message: root.error-message;
                            accent-color: root.accent-color;
                            chat-input <=> root.new-conversation-input;
                            focus-end-tick: root.nc-append;
                            cursor-len: root.nc-cursor-len;
                            create-chat(input) => { root.new-conversation(input); }
                            pick-contact(id) => { root.suggestion-selected(id); }
                            append-done() => { root.nc-append = false; }
                        }
                        if root.selected-conversation >= 0: Rectangle {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            property <int> scroll-tick: root.msg-scroll-tick;
                            property <bool> at-bottom: msg-list.viewport-y <= -(msg-list.viewport-height - msg-list.visible-height) + 8px;
                            changed scroll-tick => {
                                msg-list.viewport-y = -(msg-list.viewport-height - msg-list.visible-height);
                            }
                            changed at-bottom => {
                                root.msg-at-bottom = self.at-bottom;
                            }
                            VerticalLayout {
                                spacing: 8px;
                                msg-list := ListView {
                                    horizontal-stretch: 1;
                                    vertical-stretch: 1;
                                    for m in root.messages: VerticalLayout {
                                        spacing: 0px;
                                        Rectangle { height: 4px; }
                                        HorizontalLayout {
                                            alignment: m.is-self ? LayoutAlignment.end : LayoutAlignment.start;
                                            spacing: 8px;
                                        if !m.is-self: VerticalLayout { vertical-stretch: 1; alignment: center;
                                            Rectangle {
                                                width: 28px;
                                                height: 28px;
                                                Avatar { avatar-text: m.avatar-text; avatar-color: m.avatar-color; avatar-image: m.avatar-image; size: 28px; }
                                                TouchArea {
                                                    width: 100%;
                                                    height: 100%;
                                                    clicked => { root.request-profile(m.sender-id); }
                                                        pointer-event(ev) => {
                                                            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                                                                root.request-context(m.sender-id, root.selected-conversation, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                            }
                                                        }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            max-width: 480px;
                                            min-height: 40px;
                                            border-radius: 16px;
                                            background: m.is-self ? root.md3-primary-container : #333333;
                                            VerticalLayout {
                                                padding: 8px;
                                                spacing: 2px;
                                                if !m.is-self: Text {
                                                    text: m.sender + "  ·  " + m.created-at;
                                                    font-size: 11px;
                                                    color: #AAAAAA;
                                                    overflow: elide;
                                                }
                                                if m.attachment-image.width > 0: Rectangle {
                                                    width: 260px;
                                                    height: 200px;
                                                    border-radius: 12px;
                                                    clip: true;
                                                    background: #00000033;
                                                    Image {
                                                        width: 100%;
                                                        height: 100%;
                                                        source: m.attachment-image;
                                                        image-fit: cover;
                                                    }
                                                }
                                                if m.attachment-name != "" && !(m.attachment-image.width > 0): HorizontalLayout {
                                                    spacing: 6px;
                                                    Text {
                                                        text: "📎 " + m.attachment-name;
                                                        color: m.is-self ? root.md3-on-primary-container : #E8E8E8;
                                                        overflow: elide;
                                                    }
                                                }
                                                Text {
                                                    text: m.body;
                                                    wrap: word-wrap;
                                                    color: m.is-self ? root.md3-on-primary-container : #E8E8E8;
                                                }
                                                if m.preview-url != "": Rectangle {
                                                    width: 260px;
                                                    border-radius: 10px;
                                                    background: root.md3-surface-container-low;
                                                    clip: true;
                                                    VerticalLayout {
                                                        spacing: 0px;
                                                        if m.preview-image.width > 0: Rectangle {
                                                            width: 260px;
                                                            height: 130px;
                                                            clip: true;
                                                            background: #00000033;
                                                            Image {
                                                                width: 100%;
                                                                height: 100%;
                                                                source: m.preview-image;
                                                                image-fit: cover;
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            padding: 8px;
                                                            spacing: 2px;
                                                            if m.preview-title != "": Text {
                                                                text: m.preview-title;
                                                                font-size: 13px;
                                                                font-weight: 600;
                                                                color: root.md3-on-surface;
                                                                wrap: word-wrap;
                                                                max-height: 34px;
                                                            }
                                                            if m.preview-description != "": Text {
                                                                text: m.preview-description;
                                                                font-size: 12px;
                                                                color: root.md3-on-surface-variant;
                                                                wrap: word-wrap;
                                                                max-height: 32px;
                                                            }
                                                        }
                                                    }
                                                    TouchArea {
                                                        width: 100%;
                                                        height: 100%;
                                                        mouse-cursor: pointer;
                                                        clicked => { root.open-link(m.preview-url); }
                                                    }
                                                }
                                                if m.is-self: Text {
                                                    text: "You  ·  " + m.created-at;
                                                    font-size: 11px;
                                                    color: root.md3-on-primary-container;
                                                    horizontal-alignment: right;
                                                }
                                            }
                                        }
                                        if m.is-self: VerticalLayout { vertical-stretch: 1; alignment: center;
                                            Avatar { avatar-text: m.avatar-text; avatar-color: m.avatar-color; avatar-image: m.avatar-image; size: 28px; }
                                        }
                                    }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    if root.pending-attach-name != "": Rectangle {
                                        height: 56px;
                                        border-radius: 8px;
                                        background: root.md3-surface-container-low;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 8px;
                                            if root.pending-attach-image.width > 0: Rectangle {
                                                width: 44px;
                                                height: 44px;
                                                border-radius: 6px;
                                                clip: true;
                                                Image {
                                                    width: 100%;
                                                    height: 100%;
                                                    source: root.pending-attach-image;
                                                    image-fit: cover;
                                                }
                                            }
                                            VerticalLayout { vertical-stretch: 1; alignment: center;
                                                Text { text: root.pending-attach-name; color: root.md3-on-surface; overflow: elide; }
                                            }
                                            Rectangle { height: 100%; }
                                            VerticalLayout { vertical-stretch: 1; alignment: center;
                                                CloseButton {
                                                    text-color: root.md3-on-surface;
                                                    clicked => { root.clear-attachment(); }
                                                }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        VerticalLayout { vertical-stretch: 1; alignment: end;
                                            Button {
                                                text: "📎";
                                                width: 40px;
                                                height: composer.height;
                                                clicked => { root.choose-attachment(); }
                                            }
                                        }
                                        composer := Rectangle {
                                            horizontal-stretch: 1;
                                            height: max(48px, min(input.preferred-height + 20px, 160px));
                                            border-width: 1px;
                                            border-radius: 8px;
                                            border-color: input.has-focus ? root.md3-primary : root.md3-outline;
                                            background: root.md3-surface;
                                            input := TextInput {
                                                x: 10px;
                                                y: 10px;
                                                width: parent.width - 20px;
                                                height: parent.height - 20px;
                                                text <=> root.draft;
                                                wrap: word-wrap;
                                                single-line: false;
                                                color: root.md3-on-surface;
                                                font-size: 16px;
                                                key-pressed(event) => {
                                                    if (event.text == Key.Return && !event.modifiers.shift) {
                                                        root.send-message(root.draft);
                                                        root.draft = "";
                                                        return accept;
                                                    }
                                                    reject
                                                }
                                            }
                                            Text {
                                                x: 12px;
                                                y: 12px;
                                                text: root.draft == "" ? "Type a message…" : "";
                                                color: root.md3-outline;
                                                font-size: 16px;
                                            }
                                        }
                                        VerticalLayout { vertical-stretch: 1; alignment: end;
                                            Button {
                                                text: "Send";
                                                primary: true;
                                                accent: root.accent-color;
                                                on-accent: root.md3-on-primary;
                                                height: composer.height;
                                                enabled: root.draft != "" || root.pending-attach-name != "";
                                            clicked => {
                                                root.send-message(root.draft);
                                                root.draft = "";
                                            }
                                        }
                                    }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------------
    // Settings dialog (floating window with all settings)
    // ------------------------------------------------------------------
    if root.settings-open: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #66000000;
        TouchArea {
            width: 100%;
            height: 100%;
        }
        Rectangle {
            x: (parent.width - 420px) / 2;
            y: (parent.height - 640px) / 2;
            width: 420px;
            border-radius: 28px;
            background: root.md3-surface-container-high;
            CloseButton {
                x: parent.width - 40px;
                y: 14px;
                text-color: root.md3-on-surface;
                clicked => { root.settings-open = false; }
            }
            VerticalLayout {
                spacing: 12px;
                padding: 24px;
                Text {
                    text: "Settings";
                    font-size: 22px;
                    font-weight: 600;
                    color: root.md3-on-surface;
                }

                // Profile picture
                HorizontalLayout {
                    spacing: 14px;
                    Rectangle {
                        width: 72px;
                        height: 72px;
                        Avatar { avatar-image: root.my-avatar; avatar-text: "?"; avatar-color: root.md3-primary; size: 72px; }
                    }
                    VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 8px;
                        Text { text: "Profile picture"; font-weight: 600; color: root.md3-on-surface; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Choose image…";
                                clicked => { root.settings-choose-avatar(); }
                            }
                            Button {
                                text: "Remove";
                                clicked => { root.settings-remove-avatar(); }
                            }
                        }
                    }
                }

                Text { text: "Display name (shown to others)"; color: root.md3-on-surface-variant; }
                LineEdit { text <=> root.display-name-input; placeholder-text: "Your name"; }

                Text { text: "Two-factor authentication"; color: root.md3-on-surface-variant; }
                if !root.totp-enabled && !root.twofa-setup-open: HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "Enable 2FA";
                        clicked => { root.twofa-setup(); }
                    }
                }
                if root.twofa-setup-open: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            width: 120px;
                            height: 120px;
                            border-radius: 8px;
                            clip: true;
                            background: #FFFFFF;
                            Image {
                                source: root.twofa-qr;
                                width: 100%;
                                height: 100%;
                                image-fit: contain;
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Scan with your authenticator app, or enter the secret:";
                                font-size: 12px;
                                color: root.md3-on-surface-variant;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.twofa-secret;
                                font-size: 12px;
                                color: root.md3-on-surface;
                                wrap: word-wrap;
                            }
                        }
                    }
                    LineEdit {
                        text <=> root.twofa-code;
                        placeholder-text: "Enter 6-digit code";
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Button {
                            text: "Cancel";
                            clicked => { root.twofa-setup-open = false; root.twofa-code = ""; }
                        }
                        Button {
                            text: "Confirm";
                            primary: true;
                            accent: root.accent-color;
                            on-accent: root.md3-on-primary;
                            enabled: root.twofa-code != "";
                            clicked => { root.twofa-enable(root.twofa-code); root.twofa-code = ""; }
                        }
                    }
                }
                if root.totp-enabled && !root.twofa-disable-open: HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout { vertical-stretch: 1; alignment: center;
                        Text { text: "2FA is on"; color: root.md3-on-surface-variant; }
                    }
                    Button {
                        text: "Disable";
                        clicked => { root.twofa-disable-open = true; }
                    }
                }
                if root.twofa-disable-open: VerticalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> root.twofa-code;
                        placeholder-text: "Enter 6-digit code";
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Button {
                            text: "Cancel";
                            clicked => { root.twofa-disable-open = false; root.twofa-code = ""; }
                        }
                        Button {
                            text: "Disable";
                            primary: true;
                            accent: root.accent-color;
                            on-accent: root.md3-on-primary;
                            enabled: root.twofa-code != "";
                            clicked => { root.twofa-disable(root.twofa-code); root.twofa-code = ""; }
                        }
                    }
                }

                Text { text: "Accent color"; color: root.md3-on-surface-variant; }
                HorizontalLayout {
                    spacing: 10px;
                    for swatch in [ #7C5CE0, #1E88E5, #43A047, #E53935, #FB8C00, #8E24AA, #00ACC1, #D81B60 ]: Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: swatch;
                        border-width: root.accent-color == swatch ? 3px : 1px;
                        border-color: root.accent-color == swatch ? root.md3-on-surface : root.md3-outline;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.accent-color = swatch; }
                        }
                    }
                }

                Text { text: "Server"; color: root.md3-on-surface-variant; }
                LineEdit { text <=> root.server-input; placeholder-text: "your-server.example"; }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Connection: " + (root.ws-connected ? "live" : "reconnecting…");
                        color: root.ws-connected ? #66BB6A : root.md3-on-surface-variant;
                        horizontal-alignment: center;
                    }
                }

                Rectangle { height: 0px; horizontal-stretch: 1; }
                if root.error-message != "": Text {
                    text: root.error-message;
                    wrap: word-wrap;
                    color: root.md3-error;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Cancel";
                        clicked => { root.settings-open = false; }
                    }
                    Button {
                        text: "Save";
                        primary: true;
                        accent: root.accent-color;
                        on-accent: root.md3-on-primary;
                        clicked => {
                            root.settings-saved();
                            root.settings-open = false;
                        }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------------
    // Email verification overlay
    // ------------------------------------------------------------------
    if root.needs-verify: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: root.md3-surface;
        TouchArea {
            width: 100%;
            height: 100%;
        }
        VerticalLayout {
            spacing: 10px;
            Rectangle { height: 25%; }
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    spacing: 14px;
                    width: 360px;
                    Text {
                        text: "Verify your email";
                        font-size: 24px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        color: root.md3-on-surface;
                    }
                    Text {
                        text: "We sent a 6-digit code to your inbox. Enter it below to continue.";
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        color: root.md3-on-surface-variant;
                    }
                    LineEdit {
                        text <=> root.verify-code;
                        placeholder-text: "000000";
                        accepted(text) => {
                            root.verify(root.verify-code);
                        }
                    }
                    if root.error-message != "": Text {
                        text: root.error-message;
                        wrap: word-wrap;
                        color: root.md3-error;
                        horizontal-alignment: center;
                    }
                    Button {
                        text: "Verify";
                        primary: true;
                        accent: root.accent-color;
                        on-accent: root.md3-on-primary;
                        enabled: root.verify-code != "";
                        clicked => {
                            root.verify(root.verify-code);
                        }
                    }
                    Button {
                        text: "Resend code";
                        clicked => { root.resend-code(); }
                    }
                    Button {
                        text: "Log out";
                        clicked => { root.logout(); }
                    }
                }
            }
            Rectangle { height: 25%; }
        }
    }

    // ------------------------------------------------------------------
    // Two-factor authentication (login)
    // ------------------------------------------------------------------
    if root.needs-2fa: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: root.md3-surface;
        TouchArea {
            width: 100%;
            height: 100%;
        }
        VerticalLayout {
            spacing: 10px;
            Rectangle { height: 28%; }
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    spacing: 14px;
                    width: 360px;
                    Text {
                        text: "Two-factor authentication";
                        font-size: 24px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        color: root.md3-on-surface;
                    }
                    Text {
                        text: "Enter the 6-digit code from your authenticator app to continue.";
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        color: root.md3-on-surface-variant;
                    }
                    LineEdit {
                        text <=> root.twofa-code;
                        placeholder-text: "000000";
                        accepted(text) => {
                            root.submit-2fa(root.twofa-code);
                        }
                    }
                    if root.error-message != "": Text {
                        text: root.error-message;
                        wrap: word-wrap;
                        color: root.md3-error;
                        horizontal-alignment: center;
                    }
                    Button {
                        text: "Verify";
                        primary: true;
                        accent: root.accent-color;
                        on-accent: root.md3-on-primary;
                        enabled: root.twofa-code != "";
                        clicked => {
                            root.submit-2fa(root.twofa-code);
                        }
                    }
                    Button {
                        text: "Log out";
                        clicked => { root.logout(); }
                    }
                }
            }
            Rectangle { height: 28%; }
        }
    }

    // ------------------------------------------------------------------
    // Context menu (right-click on a user)
    // ------------------------------------------------------------------
    if root.context-open: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.context-open = false; }
        }
        Rectangle {
            property <int> item-count: (root.context-user-id >= 0 ? 3 : 0) + (root.context-conversation-id >= 0 ? 1 : 0);
            property <length> menu-height: 12px + self.item-count * 34px + max(0, self.item-count - 1) * 2px;
            x: root.context-x + self.width <= root.width ? root.context-x : max(0px, root.context-x - self.width);
            y: root.context-y + self.menu-height <= root.height ? root.context-y : max(0px, root.context-y - self.menu-height);
            width: 190px;
            height: self.menu-height;
            border-radius: 8px;
            background: root.md3-surface-container-high;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                if root.context-user-id >= 0: ContextMenuItem {
                    text: "Profile";
                    text-color: root.md3-on-surface;
                    item-background: transparent;
                    item-hover-background: root.md3-primary.with-alpha(0.16);
                    clicked => {
                        root.context-open = false;
                        root.context-profile();
                    }
                }
                if root.context-user-id >= 0: ContextMenuItem {
                    text: root.context-blocked ? "Unblock" : "Block";
                    text-color: root.md3-on-surface;
                    item-background: transparent;
                    item-hover-background: root.md3-primary.with-alpha(0.16);
                    clicked => {
                        root.context-open = false;
                        root.toggle-block();
                    }
                }
                if root.context-user-id >= 0: ContextMenuItem {
                    text: root.context-muted ? "Unmute" : "Mute";
                    text-color: root.md3-on-surface;
                    item-background: transparent;
                    item-hover-background: root.md3-primary.with-alpha(0.16);
                    clicked => {
                        root.context-open = false;
                        root.toggle-mute();
                    }
                }
                if root.context-conversation-id >= 0: ContextMenuItem {
                    text: "Delete conversation";
                    text-color: root.md3-error;
                    item-background: transparent;
                    item-hover-background: root.md3-primary.with-alpha(0.16);
                    clicked => {
                        root.context-open = false;
                        root.context-delete();
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------------
    // Profile card
    // ------------------------------------------------------------------
    if root.profile-open: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #66000000;
        TouchArea {
            width: 100%;
            height: 100%;
        }
        Rectangle {
            x: (parent.width - 340px) / 2;
            y: (parent.height - 400px) / 2;
            width: 340px;
            height: 400px;
            border-radius: 24px;
            background: root.md3-surface-container-high;
            CloseButton {
                x: parent.width - 38px;
                y: 12px;
                text-color: root.md3-on-surface;
                clicked => { root.profile-open = false; }
            }
                VerticalLayout {
                    spacing: 10px;
                    padding: 24px;
                    HorizontalLayout { alignment: center;
                        Avatar { avatar-text: root.profile.avatar-text; avatar-color: root.profile.avatar-color; avatar-image: root.profile.avatar-image; size: 72px; }
                    }
                Text {
                    text: root.profile.display-name;
                    font-size: 20px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    color: root.md3-on-surface;
                }
                Rectangle {
                    height: 32px;
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: root.profile.handle;
                            font-size: 16px;
                            horizontal-alignment: center;
                            color: handle-ta.has-hover ? root.md3-primary : root.md3-on-surface-variant;
                        }
                    }
                    handle-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            root.open-chat(root.profile.id);
                        }
                    }
                }
                if root.profile.is-self: Text {
                    text: "This is you";
                    font-size: 13px;
                    horizontal-alignment: center;
                    color: root.md3-primary;
                }
                if root.profile.blocked-by: Text {
                    text: "You are blocked by this user";
                    font-size: 13px;
                    horizontal-alignment: center;
                    color: root.md3-error;
                }
                if !root.profile.is-self: Rectangle { height: 6px; }
                if !root.profile.is-self: HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Button {
                        text: root.profile.blocked ? "Unblock" : "Block";
                        clicked => { root.toggle-block(); }
                    }
                    Button {
                        text: root.profile.muted ? "Unmute" : "Mute";
                        clicked => { root.toggle-mute(); }
                    }
                }
                Rectangle { height: 0px; horizontal-stretch: 1; }
                if root.error-message != "": Text {
                    text: root.error-message;
                    wrap: word-wrap;
                    color: root.md3-error;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    Button {
                        text: "Close";
                        clicked => { root.profile-open = false; }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------------
    // Delete conversation confirmation
    // ------------------------------------------------------------------
    if root.confirm-delete-open: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #66000000;
        TouchArea {
            width: 100%;
            height: 100%;
        }
        Rectangle {
            x: (parent.width - 380px) / 2;
            y: (parent.height - 200px) / 2;
            width: 380px;
            height: 200px;
            border-radius: 20px;
            background: root.md3-surface-container-high;
            VerticalLayout {
                spacing: 12px;
                padding: 20px;
                Text {
                    text: "Delete conversation?";
                    font-size: 18px;
                    font-weight: 600;
                    color: root.md3-on-surface;
                }
                Text {
                    text: "This will remove \"" + root.confirm-delete-title + "\" and its messages for you. This cannot be undone.";
                    wrap: word-wrap;
                    color: root.md3-on-surface-variant;
                }
                Rectangle { height: 0px; horizontal-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Cancel";
                        clicked => { root.confirm-delete-open = false; }
                    }
                    Button {
                        text: "Delete";
                        primary: true;
                        accent: root.accent-color;
                        on-accent: root.md3-on-primary;
                        clicked => {
                            root.confirm-delete();
                            root.confirm-delete-open = false;
                        }
                    }
                }
            }
        }
    }

    } // end scaleable content wrapper

    // Slint attribution (royalty-free license)
    Text {
        x: 8px;
        y: root.height - 24px;
        text: "Made with Slint";
        font-size: 10px;
        color: root.md3-outline;
    }
}
